// FormReady is a fully static site (every tool runs in the browser), so the
// Worker only serves the built files in dist/. Having this file also stops
// `wrangler deploy` from auto-adding the Astro Cloudflare adapter, which
// turns the build into a server build that fails to prerender.
{
  "name": "form-image-resizer",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "bun run build"
  },
  "assets": {
    "directory": "./dist",
    // Pages build as /hi/id-card.html and are served at /hi/id-card,
    // matching the canonical URLs (trailingSlash: "never").
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
